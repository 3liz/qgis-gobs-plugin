      <id>CoucheRequ_te_ec505230_33ec_4197_a99f_f6eae0674849</id>
      <datasource>service='gobs' key='id' checkPrimaryKeyUnicity='0' table="(SELECT 
	s.id, id_label AS indicator, id_paths AS indicator_paths,
	pt_label AS project, sl_label AS spatial_layer, pr_label AS protocol,
	count(o.id) AS nb_observation,
	min(o.ob_start_timestamp) AS min_date,
	max(Coalesce(o.ob_start_timestamp, o.ob_end_timestamp)) AS max_date
FROM gobs.series s
INNER JOIN gobs.observation o ON o.fk_id_series = s.id
INNER JOIN gobs.project pr ON pr.id = s.fk_id_project
INNER JOIN gobs.indicator i ON i.id = s.fk_id_indicator
INNER JOIN gobs.spatial_layer sl ON sl.id = s.fk_id_spatial_layer
INNER JOIN gobs.protocol p ON p.id = s.fk_id_protocol
GROUP BY s.id, id_label, id_paths, pt_label, sl_label, pr_label
ORDER BY s.id)"</datasource>
